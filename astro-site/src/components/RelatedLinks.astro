---
interface LinkItem {
  href: string;
  label: string;
  description?: string;
}

interface Props {
  title?: string;
  links: readonly LinkItem[];
  class?: string;
}

const { title = 'Continue navegando', links, class: className = 'bg-neutral' } = Astro.props;
---

<section class={`py-16 ${className}`} aria-labelledby="related-links-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 id="related-links-title" class="text-2xl font-bold tracking-tight text-ink md:text-3xl">
      {title}
    </h2>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="group flex h-full flex-col rounded-xl border border-border bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
          >
            <span class="font-semibold text-ink transition-colors group-hover:text-primary">
              {link.label}
            </span>
            {link.description && (
              <span class="mt-2 text-sm leading-relaxed text-ink-soft">{link.description}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

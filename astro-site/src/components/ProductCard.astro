---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const defaultVariant = product.variants[0];
const hasMultipleVariants = product.variants.length > 1;
---

<div class="product-card group relative flex flex-col justify-between rounded-2xl border border-gray-200/80 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-purple-300 hover:shadow-xl hover:shadow-purple-950/5" data-product-id={product.id}>
  {product.badge && (
    <div class="absolute -top-3 right-6 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 px-3.5 py-1 text-xs font-semibold text-white shadow-md">
      {product.badge}
    </div>
  )}

  <div>
    <!-- Imagem da Mídia com Efeito Glossy -->
    <div class="relative mb-5 flex h-40 items-center justify-center rounded-xl bg-slate-50 p-4 transition-colors group-hover:bg-purple-50/40">
      <img 
        src={product.image} 
        alt={product.title} 
        class="max-h-32 object-contain transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>

    <!-- Categoria & Mídia -->
    <div class="mb-2 flex items-center gap-2">
      <span class="rounded-md bg-purple-100 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-purple-800">
        {product.mediaType.toUpperCase()}
      </span>
      <span class="text-xs text-gray-500">{product.subtitle}</span>
    </div>

    <!-- Título do Produto -->
    <h3 class="mb-2 text-lg font-bold text-gray-900 group-hover:text-purple-700 transition-colors">
      {product.title}
    </h3>

    <!-- Descrição -->
    <p class="mb-4 text-xs text-gray-600 leading-relaxed">
      {product.description}
    </p>
  </div>

  <div>
    <!-- Seletor Inline de Variantes (se houver mais de 1) -->
    {hasMultipleVariants && (
      <div class="mb-4">
        <label class="mb-1.5 block text-[11px] font-semibold text-gray-700 uppercase tracking-wide">
          Selecione o período de validade:
        </label>
        <div class="flex gap-1.5 rounded-lg bg-gray-100 p-1">
          {product.variants.map((v, idx) => (
            <button
              type="button"
              data-price={v.price}
              data-checkout={v.checkoutUrl}
              class={`variant-tab flex-1 rounded-md py-1.5 text-center text-xs font-semibold transition-all ${
                idx === 0
                  ? 'active-tab bg-white text-purple-700 shadow-sm'
                  : 'text-gray-600 hover:text-gray-900'
              }`}
            >
              {v.label}
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Preço e Botão de Ação -->
    <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
      <div>
        <span class="block text-[10px] uppercase font-bold tracking-wider text-gray-500">Valor</span>
        <span class="product-price text-xl font-extrabold text-purple-900 transition-all">
          {defaultVariant.price}
        </span>
      </div>

      <a
        href={defaultVariant.checkoutUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-buy inline-flex items-center justify-center gap-2 rounded-xl bg-purple-700 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-purple-700/20 transition-all duration-200 hover:bg-purple-800 hover:shadow-lg hover:shadow-purple-800/30 hover:scale-[1.02] active:scale-95"
      >
        <span>Comprar</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.product-card').forEach(card => {
      const tabs = card.querySelectorAll('.variant-tab');
      const priceEl = card.querySelector('.product-price');
      const btnBuy = card.querySelector('.btn-buy') as HTMLAnchorElement;

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => {
            t.classList.remove('active-tab', 'bg-white', 'text-purple-700', 'shadow-sm');
            t.classList.add('text-gray-600');
          });
          tab.classList.add('active-tab', 'bg-white', 'text-purple-700', 'shadow-sm');
          tab.classList.remove('text-gray-600');

          const price = tab.getAttribute('data-price');
          const checkout = tab.getAttribute('data-checkout');

          if (priceEl && price) priceEl.textContent = price;
          if (btnBuy && checkout) btnBuy.href = checkout;
        });
      });
    });
  });
</script>

---
import { site } from '../data/site';

interface Props {
  title?: string;
  /** Mostra o mapa incorporado ao lado dos dados. */
  withMap?: boolean;
  class?: string;
}

const {
  title = 'Onde estamos — Atendimento presencial no Centro de BH',
  withMap = true,
  class: className = '',
} = Astro.props;
---

<section class={`bg-white py-16 ${className}`} aria-labelledby="nap-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">AllCert Certificados Digitais</p>
        <h2 id="nap-title" class="mt-2 text-2xl font-bold tracking-tight text-ink md:text-3xl">
          {title}
        </h2>

        <dl class="mt-6 space-y-4 text-sm">
          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <dt class="font-semibold text-ink">Endereço</dt>
              <dd class="mt-0.5 text-ink-soft">{site.address}</dd>
            </div>
          </div>

          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11 11 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <dt class="font-semibold text-ink">Telefone e WhatsApp</dt>
              <dd class="mt-0.5 text-ink-soft">
                <a class="hover:text-primary" href={site.phoneHref}>{site.phoneDisplay}</a>
                <span class="px-1 text-border">|</span>
                <a class="hover:text-primary" href={site.phoneSecondaryHref}>{site.phoneSecondaryDisplay}</a>
              </dd>
            </div>
          </div>

          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <dt class="font-semibold text-ink">E-mail</dt>
              <dd class="mt-0.5 text-ink-soft">
                <a class="hover:text-primary" href={`mailto:${site.email}`}>{site.email}</a>
              </dd>
            </div>
          </div>

          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <dt class="font-semibold text-ink">Horário de atendimento</dt>
              <dd class="mt-0.5 text-ink-soft">{site.openingHours}</dd>
            </div>
          </div>

          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <dt class="font-semibold text-ink">CNPJ</dt>
              <dd class="mt-0.5 text-ink-soft">{site.cnpj} — {site.registrationAuthorityNote}</dd>
            </div>
          </div>
        </dl>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover"
          >
            Falar no WhatsApp
          </a>
          <a
            href="/contato"
            class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3.5 text-sm font-semibold text-ink transition-colors hover:border-primary hover:text-primary"
          >
            Ver página de contato
          </a>
        </div>
      </div>

      {withMap && (
        <div class="overflow-hidden rounded-2xl border border-border shadow-sm">
          <iframe
            src={site.mapsEmbed}
            title="Mapa da AllCert Certificados Digitais na R. São Paulo, 1071 - Centro, Belo Horizonte"
            width="100%"
            height="380"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      )}
    </div>
  </div>
</section>

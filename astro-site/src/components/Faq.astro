---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section id="faq" class="bg-neutral">
  <div class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary">Dúvidas frequentes</p>
    <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink md:text-4xl">
      Perguntas e respostas
    </h2>

    <div class="mt-8 space-y-3">
      {items.map((item) => (
        <details class="group rounded-lg border border-border bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-ink hover:text-primary">
            {item.q}
            <svg class="shrink-0 transition-transform group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="px-5 pb-5 text-sm leading-relaxed text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

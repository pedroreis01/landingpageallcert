---
import { site } from '../data/site';
---

<section class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">

      <!-- Copy B2B -->
      <div class="text-center lg:col-span-6 lg:text-left">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary-soft px-4 py-1.5 text-xs font-semibold text-primary">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Validade jurídica ICP-Brasil garantida</span>
        </div>

        <h1 class="mt-6 text-4xl font-bold leading-[1.12] tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]">
          Emita seu <span class="text-primary">Certificado Digital em 15 Minutos</span> por Videoconferência — Sem Filas e Sem Burocracia
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-soft lg:mx-0">
          Garantia jurídica nacional (ICP-Brasil) para você e sua empresa assinarem contratos, emitirem
          NF-e e acessarem sistemas governamentais no mesmo dia.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a
            href="#produtos"
            class="inline-flex w-full items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-primary-hover sm:w-auto"
          >
            <span>Emitir meu certificado</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border px-6 py-4 text-base font-semibold text-ink transition-colors hover:border-primary hover:text-primary sm:w-auto"
          >
            <svg class="h-5 w-5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
            </svg>
            <span>Falar com especialista</span>
          </a>
        </div>

        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-border pt-6 sm:grid-cols-4 sm:gap-x-6">
          <a
            href="https://share.google/gfQBxDJen381allDO"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver avaliações da AllCert no Google"
            class="group flex cursor-pointer flex-col items-center gap-1 text-center transition-all hover:scale-105 hover:text-primary lg:items-start lg:text-left"
          >
            <span class="flex items-center gap-1 text-sm font-bold text-ink transition-all group-hover:text-primary">
              5.0
              <span class="text-amber-400" aria-hidden="true">★★★★★</span>
            </span>
            <span class="text-xs text-ink-soft underline-offset-2 transition-all group-hover:text-primary group-hover:underline">no Google Reviews ↗</span>
          </a>
          <div class="flex flex-col items-center gap-1 text-center lg:items-start lg:text-left">
            <span class="text-sm font-bold text-ink">+3.600</span>
            <span class="text-xs text-ink-soft">Certificados Emitidos</span>
          </div>
          <div class="flex flex-col items-center gap-1 text-center lg:items-start lg:text-left">
            <span class="text-sm font-bold text-ink">100% Online</span>
            <span class="text-xs text-ink-soft">Emissão em 15 min</span>
          </div>
          <div class="flex flex-col items-center gap-1 text-center lg:items-start lg:text-left">
            <span class="text-sm font-bold text-ink">Credenciado</span>
            <span class="text-xs text-ink-soft">ICP-Brasil</span>
          </div>
        </div>
      </div>

      <!-- Vídeo do token USB -->
      <div class="relative lg:col-span-6">
        <div class="relative mx-auto max-w-lg">
          <div class="group relative overflow-hidden rounded-2xl border border-primary/20 shadow-2xl">
            <video
              src="/images/usb-token-animation-loop.mp4"
              class="aspect-[4/3] w-full object-cover"
              autoplay
              muted
              playsinline
              loop
              preload="metadata"
              aria-label="Animação do token USB de certificado digital ICP-Brasil"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent"></div>
            <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/10"></div>
          </div>

          <div class="absolute -bottom-6 left-1/2 w-[calc(100%-2rem)] -translate-x-1/2 rounded-xl border border-border bg-white/95 p-4 shadow-lg backdrop-blur sm:left-auto sm:right-4 sm:w-64 sm:translate-x-0">
            <div class="flex items-center gap-3">
              <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary/30"></span>
                <svg class="relative h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-ink">Conexão Autenticada</p>
                <p class="text-xs text-ink-soft">ICP-Brasil · AllCert</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

---
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  ctaText = 'Falar com um especialista',
  ctaHref = site.whatsapp,
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-purple-950 to-slate-900 py-16 text-white lg:py-20">
  <div class="absolute top-1/4 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-purple-600/20 blur-3xl"></div>
  <div class="absolute top-1/3 right-10 -z-10 h-80 w-80 rounded-full bg-indigo-600/15 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7 text-center lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-purple-500/10 px-4 py-1.5 text-xs font-semibold text-purple-300 ring-1 ring-purple-500/30 backdrop-blur-md">
          <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          {eyebrow}
        </span>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl leading-[1.15]">
          {title}
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-purple-200/80 lg:mx-0 lg:text-lg">
          {description}
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a
            href={ctaHref}
            target="_blank"
            rel="noopener"
            class="inline-flex w-full items-center justify-center gap-3 rounded-xl bg-purple-600 px-8 py-4 text-base font-bold text-white shadow-lg shadow-purple-600/30 transition-all duration-200 hover:-translate-y-0.5 hover:bg-purple-500 hover:shadow-purple-500/40 active:translate-y-0 sm:w-auto"
          >
            <span>{ctaText}</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-slate-800/80 pt-6 text-xs text-slate-400 lg:justify-start">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Emissão por videoconferência</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Validade jurídica ICP-Brasil</span>
          </div>
        </div>
      </div>

      <div class="relative flex justify-center lg:col-span-5">
        <div class="group relative w-full max-w-lg">
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 opacity-30 blur-xl transition-all duration-500 group-hover:opacity-50"></div>
          <div class="relative overflow-hidden rounded-2xl border border-slate-700/80 bg-slate-900 p-2 shadow-2xl">
            <img
              src={image}
              alt={imageAlt}
              class="h-auto w-full rounded-xl object-cover shadow-inner transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  ctaText = 'Falar com um especialista',
  ctaHref = site.whatsapp,
} = Astro.props;
---

<section class="border-b border-border bg-neutral py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="text-center lg:col-span-6 lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-soft px-4 py-1.5 text-xs font-semibold text-primary">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {eyebrow}
        </span>

        <h1 class="mt-6 text-3xl font-bold leading-[1.15] tracking-tight text-ink sm:text-4xl lg:text-5xl">
          {title}
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-soft lg:mx-0 lg:text-lg">
          {description}
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a
            href={ctaHref}
            target="_blank"
            rel="noopener"
            class="inline-flex w-full items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-primary-hover sm:w-auto"
          >
            <span>{ctaText}</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-border pt-6 text-xs text-ink-soft lg:justify-start">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Emissão por videoconferência</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Validade jurídica ICP-Brasil</span>
          </div>
        </div>
      </div>

      <div class="relative lg:col-span-6">
        <img
          src={image}
          alt={imageAlt}
          class="mx-auto w-full max-w-lg rounded-2xl border border-border object-cover shadow-xl"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

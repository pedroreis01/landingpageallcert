---
import { site, nav } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-border bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" aria-label="AllCert — página inicial">
      <img src="/images/logoAllcert.png" alt="AllCert Certificados Digitais" width="150" height="40" class="h-9 w-auto" />
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navegação principal">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-semibold text-ink-soft transition-colors hover:text-primary">
          {item.label}
        </a>
      ))}
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover"
      >
        Emitir agora
      </a>
    </nav>

    <!-- Menu mobile sem JS -->
    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-md p-2 text-ink" aria-label="Abrir menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-lg border border-border bg-white p-2 shadow-lg">
        {nav.map((item) => (
          <a href={item.href} class="block rounded-md px-3 py-2 text-sm font-semibold text-ink hover:bg-primary-soft hover:text-primary">
            {item.label}
          </a>
        ))}
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="mt-1 block rounded-md bg-primary px-3 py-2.5 text-center text-sm font-semibold text-white hover:bg-primary-hover"
        >
          Emitir agora
        </a>
      </div>
    </details>
  </div>
</header>

---
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  bullets?: readonly string[];
  image: string;
  imageAlt: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  description,
  bullets = [],
  image,
  imageAlt,
  ctaText = 'Emitir pelo WhatsApp',
  ctaHref = site.whatsapp,
  secondaryText = 'Ver preços e opções',
  secondaryHref = '/#produtos',
} = Astro.props;
---

<section class="border-b border-border bg-neutral py-14 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="text-center lg:col-span-6 lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-soft px-4 py-1.5 text-xs font-semibold text-primary">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {eyebrow}
        </span>

        <h1 class="mt-6 text-3xl font-bold leading-[1.15] tracking-tight text-ink sm:text-4xl lg:text-[2.75rem]">
          {title}
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-soft lg:mx-0 lg:text-lg">
          {description}
        </p>

        {bullets.length > 0 && (
          <ul class="mx-auto mt-6 max-w-xl space-y-2.5 text-left lg:mx-0">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-sm text-ink-soft">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span set:html={bullet} />
              </li>
            ))}
          </ul>
        )}

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row lg:justify-start">
          <a
            href={ctaHref}
            target={ctaHref.startsWith('http') ? '_blank' : undefined}
            rel={ctaHref.startsWith('http') ? 'noopener' : undefined}
            class="inline-flex w-full items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-primary-hover sm:w-auto"
          >
            <span>{ctaText}</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href={secondaryHref}
            class="inline-flex w-full items-center justify-center rounded-lg border border-border bg-white px-8 py-4 text-base font-semibold text-ink transition-colors hover:border-primary hover:text-primary sm:w-auto"
          >
            {secondaryText}
          </a>
        </div>

        <p class="mt-6 text-xs leading-relaxed text-ink-soft/80">
          {site.legalName} · {site.address} · {site.phoneDisplay} / {site.phoneSecondaryDisplay}
        </p>
      </div>

      <div class="relative lg:col-span-6">
        <img
          src={image}
          alt={imageAlt}
          width="960"
          height="640"
          class="mx-auto w-full max-w-lg rounded-2xl border border-border object-cover shadow-xl"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

---
import { site } from '../data/site';

const channels = [
  {
    label: 'E-mail',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: 'M4 6h16v12H4zM4 7l8 6 8-6',
  },
  {
    label: 'Telefone',
    value: site.phoneDisplay,
    href: site.phoneHref,
    icon: 'M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z',
  },
  {
    label: 'WhatsApp',
    value: '(31) 99524-6581',
    href: site.whatsapp,
    icon: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm4.4 12.2c-.2.5-1.1 1-1.5 1-.4.1-.9.1-1.4-.1-3.2-1.4-5.3-4.6-5.4-4.8-.1-.2-1.2-1.7-1.2-3.2s.8-2.2 1-2.5c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.1.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 .9c.3.2.5.3.6.4.1.2.1.6-.1 1Z',
  },
  {
    label: 'Endereço',
    value: site.city,
    href: 'https://maps.app.goo.gl/your-link',
    icon: 'M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Zm0-8.5A2.5 2.5 0 1 0 12 7a2.5 2.5 0 0 0 0 5.5Z',
  },
];
---

<section id="contato" class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary">Contato</p>
    <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink md:text-4xl">Fale com a gente</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Estamos prontos para atender você. Escolha o canal de sua preferência e emita hoje mesmo.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {channels.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel={c.href.startsWith('http') ? 'noopener' : undefined}
          class="rounded-lg border border-border bg-white p-6 transition hover:-translate-y-1 hover:border-primary hover:shadow-[0_8px_30px_rgba(128,64,240,0.12)]"
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-md bg-primary-soft text-primary">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={c.icon} />
            </svg>
          </span>
          <span class="mt-4 block text-xs font-semibold uppercase tracking-wider text-ink-soft">{c.label}</span>
          <span class="mt-1 block font-semibold text-ink">{c.value}</span>
        </a>
      ))}
    </div>

    <div class="mt-10 overflow-hidden rounded-lg border border-border">
      <iframe
        src={site.mapsEmbed}
        width="600"
        height="450"
        style="border:0; width:100%;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa com a localização da AllCert em Belo Horizonte"
      ></iframe>
    </div>
  </div>
</section>

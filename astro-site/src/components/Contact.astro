---
import { site } from '../data/site';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';

const WHATSAPP_ICON = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z';

const channels = [
  {
    label: 'E-mail',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: 'M4 6h16v12H4zM4 7l8 6 8-6',
    brand: false,
  },
  {
    label: 'Telefone',
    value: site.phoneDisplay,
    href: site.phoneHref,
    icon: 'M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z',
    brand: false,
  },
  {
    label: 'WhatsApp',
    value: '(31) 99524-6581',
    href: site.whatsapp,
    icon: WHATSAPP_ICON,
    brand: true,
  },
  {
    label: 'Endereço',
    value: site.city,
    href: 'https://maps.app.goo.gl/your-link',
    icon: 'M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Zm0-8.5A2.5 2.5 0 1 0 12 7a2.5 2.5 0 0 0 0 5.5Z',
    brand: false,
  },
];
---

<section id="contato" class={isDark ? 'bg-gradient-to-br from-[#1F1F1F] via-[#1e1b4b] to-[#8040F0] relative overflow-hidden' : 'bg-white'}>
  {isDark && (
    <>
      <div class="absolute top-0 left-1/4 -z-0 h-72 w-72 rounded-full bg-purple-500/20 blur-3xl"></div>
      <div class="absolute bottom-0 right-10 -z-0 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>
    </>
  )}
  <div class="relative mx-auto max-w-6xl px-4 py-20">
    <p class={`text-xs font-semibold uppercase tracking-wider ${isDark ? 'text-lavender' : 'text-primary'}`}>Contato</p>
    <h2 class={`mt-2 text-3xl font-semibold tracking-tight md:text-4xl ${isDark ? 'text-white' : 'text-ink'}`}>Fale com a gente</h2>
    <p class={`mt-3 max-w-2xl ${isDark ? 'text-white/70' : 'text-ink-soft'}`}>
      Estamos prontos para atender você. Escolha o canal de sua preferência e emita hoje mesmo.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {channels.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel={c.href.startsWith('http') ? 'noopener' : undefined}
          class={isDark
            ? 'rounded-xl border border-white/10 bg-white p-6 shadow-lg shadow-black/30 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-purple-900/40'
            : 'rounded-lg border border-border bg-white p-6 transition hover:-translate-y-1 hover:border-primary hover:shadow-[0_8px_30px_rgba(128,64,240,0.12)]'}
        >
          <span class={`flex h-11 w-11 items-center justify-center rounded-md ${c.brand ? 'bg-emerald-50 text-emerald-600' : 'bg-primary-soft text-primary'}`}>
            {c.brand ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={c.icon} />
              </svg>
            ) : (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={c.icon} />
              </svg>
            )}
          </span>
          <span class="mt-4 block text-xs font-semibold uppercase tracking-wider text-ink-soft">{c.label}</span>
          <span class="mt-1 block font-semibold text-ink">{c.value}</span>
        </a>
      ))}
    </div>

    <div class={`mt-10 overflow-hidden rounded-xl ${isDark ? 'border border-white/10 shadow-2xl' : 'border border-border'}`}>
      <iframe
        src={site.mapsEmbed}
        width="600"
        height="450"
        style="border:0; width:100%;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title="Mapa com a localização da AllCert em Belo Horizonte"
      ></iframe>
    </div>
  </div>
</section>

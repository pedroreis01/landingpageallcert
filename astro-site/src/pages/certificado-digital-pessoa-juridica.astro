---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductsByCategory } from '../data/products';

const products = getProductsByCategory('pj');
---

<Base 
  title="Certificado Digital Pessoa Jurídica (e-CNPJ) | AllCert"
  description="Emita seu Certificado Digital Pessoa Jurídica (e-CNPJ A1, A3, Token, Cartão ou Leitora) para sua empresa emitir notas e acessar e-CAC."
>
  <section class="bg-gradient-to-b from-slate-900 to-purple-950 py-16 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-block rounded-full bg-purple-500/20 px-4 py-1 text-xs font-semibold text-purple-300 ring-1 ring-purple-500/30">
          Para sua Empresa
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
          Certificado Digital Pessoa Jurídica (e-CNPJ)
        </h1>
        <p class="mt-4 text-base text-purple-200/80 sm:text-lg">
          Emita notas fiscais, acesse o e-CAC, Conectividade Social e garanta a gestão segura do seu negócio.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
</Base>

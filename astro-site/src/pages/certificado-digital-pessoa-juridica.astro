---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import PageBanner from '../components/PageBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductsByCategory } from '../data/products';

const products = getProductsByCategory('pj');
---

<Base
  title="Certificado Digital Pessoa Jurídica (e-CNPJ) | AllCert"
  description="Emita seu Certificado Digital Pessoa Jurídica (e-CNPJ A1, A3, Token, Cartão ou Leitora) para sua empresa emitir notas e acessar e-CAC."
>
  <Header />
  <main>
    <PageBanner
      eyebrow="Certificado Digital para sua Empresa"
      title="Mantenha sua empresa operando sem burocracia e sem filas"
      description="Emita notas fiscais, acesse o e-CAC, Conectividade Social e o Simples Nacional com o e-CNPJ. Validação por videoconferência, emissão no mesmo dia e suporte dedicado para o sócio, contador ou representante legal."
      image="/images/banner-pj.jpg"
      imageAlt="Representante legal de empresa emitindo certificado digital pessoa jurídica"
      ctaText="Emitir e-CNPJ da minha empresa"
    />

    <section class="bg-slate-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {products.map(product => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

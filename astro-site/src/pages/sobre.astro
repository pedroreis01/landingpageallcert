---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Sobre a ${site.name}`,
  url: `${site.url}/sobre`,
  mainEntity: {
    '@type': 'Organization',
    name: site.legalName,
    url: site.url,
    email: site.email,
    telephone: '+55-31-97151-7322',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Belo Horizonte',
      addressRegion: 'MG',
      addressCountry: 'BR',
    },
    // TODO Fase 2: incluir CNPJ e sameAs (Google Business, redes) assim que confirmados
  },
};
---

<Base
  title="Sobre a AllCert — Autoridade de Registro ICP-Brasil | AllCert"
  description="Conheça a AllCert: Autoridade de Registro em parceria com a Soluti, especializada em certificação digital com atendimento humano em Belo Horizonte e emissão por videoconferência em todo o Brasil."
  jsonLd={[aboutPageLd]}
>
  <Header />
  <main>
    <section class="bg-ink text-white">
      <div class="mx-auto max-w-4xl px-4 py-16 text-center md:py-20">
        <p class="text-xs font-semibold uppercase tracking-wider text-lavender">Sobre nós</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">
          Uma Autoridade de Registro ICP-Brasil com atendimento humano
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/70 md:text-lg">
          A AllCert é uma Autoridade de Registro em parceria com a Certificadora Soluti, sediada
          em Belo Horizonte e com atendimento em todo o Brasil por videoconferência.
        </p>
      </div>
    </section>

    <About />

    <section class="bg-neutral">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="grid gap-5 sm:grid-cols-3">
          <div class="rounded-lg bg-white p-6">
            <p class="font-semibold text-ink">Autoridade de Registro</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              Validamos sua identidade conforme as normas do ITI e da ICP-Brasil, com
              responsabilidade e conformidade em cada emissão.
            </p>
          </div>
          <div class="rounded-lg bg-white p-6">
            <p class="font-semibold text-ink">Parceria com a Soluti</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              Certificados emitidos em parceria com a Soluti, uma das maiores certificadoras
              ICP-Brasil do país.
            </p>
          </div>
          <div class="rounded-lg bg-white p-6">
            <p class="font-semibold text-ink">Atendimento em todo o Brasil</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              Validação por videoconferência: você emite seu certificado de onde estiver, com
              suporte dedicado do início ao fim.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-3xl px-4 py-14 text-center">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">Quer saber mais?</h2>
        <p class="mx-auto mt-3 max-w-xl text-ink-soft">
          Fale com nossa equipe e tire suas dúvidas sobre qual certificado é ideal para você.
        </p>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block rounded-md bg-primary px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover"
        >
          Falar no WhatsApp
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

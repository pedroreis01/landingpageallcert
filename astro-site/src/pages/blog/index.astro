---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import BlogCard from '../../components/BlogCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import NapCard from '../../components/NapCard.astro';
import { site, solutionLinks } from '../../data/site';
import { blogLd, breadcrumbLd, localBusinessLd, organizationLd } from '../../lib/schema';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featuredPost, ...restPosts] = posts;

const categories = [...new Set(posts.map((post) => post.data.category))];

const title = 'Blog AllCert | Guias sobre Certificado Digital ICP-Brasil';
const description =
  'Artigos práticos sobre certificado digital: e-CNPJ, e-CPF, A1, A3, certificado em nuvem, OAB e renovação. Conteúdo da AllCert, Autoridade de Registro em Belo Horizonte.';

const jsonLd = [
  organizationLd,
  localBusinessLd,
  blogLd('/blog'),
  breadcrumbLd([
    { name: 'Início', href: '/' },
    { name: 'Blog', href: '/blog' },
  ]),
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Header />

  <main>
    <section class="border-b border-border bg-neutral py-14 md:py-18">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <nav aria-label="Você está aqui" class="text-xs text-ink-soft">
          <a href="/" class="hover:text-primary">Início</a>
          <span class="px-1.5 text-border">/</span>
          <span class="font-semibold text-ink">Blog</span>
        </nav>

        <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-primary">
          Conteúdo AllCert
        </p>
        <h1 class="mt-2 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl lg:text-5xl">
          Blog do Certificado Digital: tudo sobre e-CNPJ, e-CPF, A1, A3 e nuvem
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-ink-soft">
          Guias escritos pelos agentes de registro da AllCert, em Belo Horizonte, para quem precisa
          emitir, usar ou renovar um certificado ICP-Brasil sem enrolação. Atendemos presencialmente
          na {site.address.split(' - Sl')[0]} e por videoconferência em todo o Brasil.
        </p>

        <ul class="mt-8 flex flex-wrap gap-2">
          {categories.map((category) => (
            <li class="rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-semibold text-ink-soft">
              {category}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {featuredPost && (
      <section class="bg-white pt-14">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary">Em destaque</p>
          <div class="mt-5">
            <BlogCard post={featuredPost} featured />
          </div>
        </div>
      </section>
    )}

    <section class="bg-white py-14">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold tracking-tight text-ink md:text-3xl">Todos os artigos</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">
          {posts.length} guias completos sobre certificação digital ICP-Brasil.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {restPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks
      title="Páginas mais procuradas"
      links={solutionLinks.map((link) => ({ ...link }))}
    />

    <CtaBand
      title="Ficou com dúvida depois de ler?"
      description="Fale com um agente de registro da AllCert pelo WhatsApp e emita seu certificado digital por videoconferência, no mesmo dia."
    />

    <NapCard />
  </main>

  <Footer />
  <WhatsAppFloat />
</Base>

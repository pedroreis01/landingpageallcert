---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import PageBanner from '../components/PageBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductsByCategory } from '../data/products';

const products = getProductsByCategory('oab');
---

<Base
  title="Certificado Digital para Advogados, Médicos e Contadores (OAB / CRM / CRC) | AllCert"
  description="Certificado Digital profissional para advogados (PJe), médicos (prontuário eletrônico) e contadores com condições exclusivas."
>
  <Header />
  <main>
    <PageBanner
      eyebrow="Condições Especiais para Profissionais"
      title="A ferramenta certa para advogados, médicos e contadores atuarem sem interrupção"
      description="Peticione no PJe, assine prontuários eletrônicos e valide documentos com a agilidade que sua profissão exige. Condições exclusivas para OAB, CRM e CRC, com emissão por videoconferência e validade de até 3 anos."
      image="/images/banner-oab.jpg"
      imageAlt="Profissional liberal utilizando certificado digital OAB, CRM ou CRC"
      ctaText="Emitir meu certificado profissional"
    />

    <section class="bg-slate-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {products.map(product => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

const whatsappPromo =
  'https://wa.me/5531995246581?text=Ol%C3%A1!%20Vi%20o%20an%C3%BAncio%20do%20certificado%20digital%20por%20R%24%20144%2C90%20e%20gostaria%20de%20saber%20mais.';

const googleReviews = 'https://share.google/gfQBxDJen381allDO';

const seals = [
  { src: '/images/icp-brasil-logo.png', alt: 'ICP-Brasil — Infraestrutura de Chaves Públicas Brasileira' },
  { src: '/images/iti-logo.png', alt: 'ITI — Instituto Nacional de Tecnologia da Informação' },
  { src: '/images/logo-Soluti.png', alt: 'Soluti — Autoridade Certificadora parceira' },
];

const benefits = [
  {
    title: 'Pagamento Pós-Emissão',
    text: 'Risco zero: você só paga depois que o certificado estiver emitido e instalado.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Atendimento Humano Express',
    text: 'Especialistas de verdade no WhatsApp, sem robôs, filas ou burocracia.',
    icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
  },
  {
    title: 'Suporte de Instalação Grátis',
    text: 'Acompanhamos você até o certificado estar instalado e funcionando.',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
  },
  {
    title: '100% Válido para NF-e e e-CAC',
    text: 'e-CNPJ A1 ICP-Brasil com validade jurídica total para notas fiscais e serviços do governo.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
];

const steps = [
  { title: 'Clique e fale no WhatsApp', text: 'Nossa equipe responde na hora e já inicia o seu atendimento.' },
  { title: 'Faça a videoconferência rápida (10 min)', text: 'Validação de identidade online, do celular ou computador, sem sair de casa.' },
  { title: 'Instale, use e pague depois!', text: 'Certificado emitido e instalado com nosso suporte. Só então você realiza o pagamento.' },
];

const faqItems = [
  {
    q: 'Como funciona o pagamento após a emissão?',
    a: 'Você faz a videoconferência, recebemos a emissão e instalamos o certificado com você. Somente depois de o certificado estar emitido e instalado é que enviamos os dados de pagamento dos R$ 144,90. Nenhum valor é cobrado antes.',
  },
  {
    q: 'O que preciso para a videoconferência?',
    a: 'Um documento oficial com foto (CNH ou RG), o CNPJ da empresa e um celular ou computador com câmera e internet. Nossa equipe informa a lista completa de documentos no WhatsApp.',
  },
  {
    q: 'Quanto tempo demora para usar?',
    a: 'A videoconferência leva cerca de 10 minutos e a emissão costuma ser concluída em até 15 minutos, permitindo usar o certificado no mesmo dia.',
  },
  {
    q: 'Serve para emitir Nota Fiscal?',
    a: 'Sim. O e-CNPJ A1 é um certificado ICP-Brasil com validade jurídica total, aceito para emissão de NF-e, acesso ao e-CAC da Receita Federal e assinatura digital de documentos.',
  },
];

const offerLd = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  itemOffered: {
    '@type': 'Service',
    name: 'Certificado Digital Pessoa Jurídica A1 (e-CNPJ)',
    provider: { '@type': 'Organization', name: site.legalName, url: site.url },
  },
  price: '144.90',
  priceCurrency: 'BRL',
  priceValidUntil: '2026-12-31',
  availability: 'https://schema.org/InStock',
  url: `${site.url}/promocao`,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const waIcon =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z';

const ctaClass =
  'inline-flex w-full items-center justify-center gap-3 rounded-xl bg-[#25D366] px-8 py-5 text-lg font-bold text-white shadow-lg shadow-[#25D366]/30 transition-all hover:scale-[1.02] hover:bg-[#1ebe5a] sm:w-auto';
---

<Base
  title="Certificado Digital e-CNPJ A1 por R$ 144,90 | Pague só depois de emitido | AllCert"
  description="Certificado Digital e-CNPJ A1 por apenas R$ 144,90. Emissão 100% online por videoconferência em 15 minutos, validade ICP-Brasil e pagamento somente após a emissão."
  jsonLd={[offerLd, faqLd]}
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-b from-primary-soft/60 to-white">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center md:py-20">
        <span class="inline-flex items-center rounded-full bg-red-50 px-4 py-1.5 text-sm font-bold text-red-600 ring-1 ring-red-200">
          🔥 Oferta Exclusiva por Tempo Limitado
        </span>

        <h1 class="mt-6 text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl md:text-5xl">
          Certificado Digital e-CNPJ A1 por Apenas <span class="text-primary">R$ 144,90</span>
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
          Emissão 100% online por videoconferência em 15 minutos. Validade ICP-Brasil.
        </p>

        <div class="mt-6 flex flex-wrap items-baseline justify-center gap-x-3 gap-y-1">
          <span class="text-lg text-ink-soft">De <span class="line-through">R$ 220,00</span> por</span>
          <span class="text-5xl font-extrabold text-primary md:text-6xl">R$ 144,90</span>
        </div>

        <p class="mx-auto mt-6 inline-flex max-w-xl items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 px-5 py-3 text-base font-semibold text-emerald-800">
          🛡️ Você só paga DEPOIS do certificado emitido e instalado!
        </p>

        <div class="mt-8 flex justify-center">
          <a href={whatsappPromo} target="_blank" rel="noopener noreferrer" class={ctaClass}>
            <svg class="h-7 w-7 flex-none" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={waIcon}></path>
            </svg>
            <span>Garantir Oferta por R$ 144,90 no WhatsApp</span>
          </a>
        </div>

        <!-- Prova social -->
        <div class="mt-10 flex flex-col items-center gap-6 border-t border-border pt-8">
          <a
            href={googleReviews}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver avaliações da AllCert no Google"
            class="group inline-flex items-center gap-3 rounded-full border border-border bg-white px-5 py-2.5 shadow-sm transition-all hover:scale-105 hover:border-primary"
          >
            <span class="text-base font-bold text-ink">5.0</span>
            <span class="text-amber-400" aria-hidden="true">★★★★★</span>
            <span class="text-sm text-ink-soft group-hover:text-primary group-hover:underline">no Google Reviews ↗</span>
          </a>
          <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
            {seals.map((seal) => (
              <img src={seal.src} alt={seal.alt} height="40" class="h-10 w-auto object-contain" />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Benefícios -->
    <section class="bg-neutral">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="text-center text-2xl font-bold tracking-tight text-ink md:text-3xl">
          Por que escolher a AllCert
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-ink-soft">
          Tudo o que sua empresa precisa, sem risco e sem complicação.
        </p>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {benefits.map((b) => (
            <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
              <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary-soft text-primary">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={b.icon}></path>
                </svg>
              </span>
              <h3 class="mt-4 font-semibold text-ink">{b.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{b.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Passo a passo -->
    <section class="bg-white">
      <div class="mx-auto max-w-5xl px-4 py-16">
        <h2 class="text-center text-2xl font-bold tracking-tight text-ink md:text-3xl">
          Como conseguir o seu em 3 passos
        </h2>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          {steps.map((s, i) => (
            <li class="rounded-xl border border-border p-6 text-center">
              <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary text-xl font-bold text-white">
                {i + 1}
              </span>
              <h3 class="mt-4 font-semibold text-ink">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Faq items={faqItems} />

    <!-- CTA final -->
    <section class="bg-ink text-white">
      <div class="mx-auto max-w-3xl px-4 py-16 text-center">
        <h2 class="text-2xl font-bold tracking-tight md:text-4xl">
          Não deixe essa oferta passar: e-CNPJ A1 por R$ 144,90
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-white/70">
          Emissão em 15 minutos, suporte de instalação grátis e pagamento somente depois de tudo
          funcionando. Fale agora com um especialista e garanta seu desconto.
        </p>
        <div class="mt-8 flex justify-center">
          <a href={whatsappPromo} target="_blank" rel="noopener noreferrer" class={ctaClass}>
            <svg class="h-7 w-7 flex-none" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={waIcon}></path>
            </svg>
            <span>Garantir Oferta por R$ 144,90 no WhatsApp</span>
          </a>
        </div>
        <p class="mt-4 text-sm text-white/60">🛡️ Você só paga DEPOIS do certificado emitido e instalado.</p>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>
